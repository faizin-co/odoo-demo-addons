<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bill_confirm_warning_wizard_form" model="ir.ui.view">
        <field name="name">bill.confirm.warning.wizard.form</field>
        <field name="model">bill.confirm.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Vendor Bill">
                <group>
                    <field name="message" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"/>
                    <button name="action_cancel"
                            string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

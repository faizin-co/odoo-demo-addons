<odoo>
    <record id="product_template_form_custom_fields" model="ir.ui.view">
        <field name="name">product.template.form.custom.fields</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='default_code']" position="after">
                <field name="x_catalog_number" placeholder="Contoh: KAT-2026-001"/>
            </xpath>

        </field>
    </record>
</odoo>

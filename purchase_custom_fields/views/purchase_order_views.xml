<odoo>
  <record id="view_purchase_order_form_inherit_so_id" model="ir.ui.view">
    <field name="name">purchase.order.form.inherit.so_id</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_ref']" position="after">
        <field name="so_id" options="{'no_create': True}"/>
      </xpath>
    </field>
  </record>
</odoo>
